# ResearchOS Configuration
# Copy this file to .env and fill in your keys

# LLM Provider: 'gemini' (default) or 'groq'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Embedding Model (Gemini text-embedding-004)
EMBEDDING_MODEL=text-embedding-004

# Vector DB: Qdrant Cloud
QDRANT_URL=https://your-cluster-url.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=researchos_papers

# Relational DB: Neon Postgres (pooled connection string, sslmode=require)
# e.g., postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/researchos?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/researchos?sslmode=require

# App Security & Limits
ACCESS_CODE=
MAX_LLM_CALLS_PER_RUN=25
MAX_PAPERS_DEFAULT=6
PORT=8000
BASE_URL=http://localhost:8000
